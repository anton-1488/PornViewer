<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.plovdev.pornviewer</groupId>
    <artifactId>pornviewer-root</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>PornViewer</name>
    <description>Watch likly video in secure viewer!</description>
    <url>https://github.com/plovdev/PornViewer</url>

    <modules>
        <module>core</module>
        <module>http</module>
        <module>database</module>
        <module>ui</module>
        <module>security</module>
        <module>services</module>
        <module>pvvasupport</module>
        <module>pvvfsupport</module>
        <module>app</module>
        <module>server</module>
    </modules>

    <licenses>
        <license>
            <name>The Unlicense</name>
            <url>https://unlicense.org</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Anton</name>
            <email>ap67253100@gmail.com</email>
            <organization>PlovDev</organization>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/plovdev/PornViewer.git</connection>
        <developerConnection>scm:git:git@github.com:plovdev/PornViewer.git</developerConnection>
        <url>https://github.com/plovdev/PornViewer</url>
    </scm>

    <properties>
        <revision>2.0</revision>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <pvva.version>1.7</pvva.version>
        <eda.version>1.1</eda.version>

        <caffeine.version>3.2.4</caffeine.version>
        <slf4j.version>2.0.18</slf4j.version>
        <gson.version>2.14.0</gson.version>

        <junit.version>6.0.3</junit.version>
        <junit.scope>test</junit.scope>

        <jspec.version>1.0.0</jspec.version>
        <jspec.scope>provided</jspec.scope>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.plovdev</groupId>
            <artifactId>pvva-core</artifactId>
            <version>${pvva.version}</version>
        </dependency>
        <dependency>
            <groupId>org.plovdev</groupId>
            <artifactId>eda</artifactId>
            <version>${eda.version}</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>${caffeine.version}</version>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>${jspec.version}</version>
            <scope>${jspec.scope}</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>${junit.scope}</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>${junit.scope}</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    <flattenedPomFilename>${project.build.directory}/.flattened-pom.xml</flattenedPomFilename>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>